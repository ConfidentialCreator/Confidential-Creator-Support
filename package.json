{
  "name": "ccsupport",
  "version": "0.0.0",
  "private": true,
  "description": "Recurring creator support on Solana where the fact of support is public and the amount is confidential",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "amount:check": "node scripts/amount-guard.mjs",
    "gate": "pnpm amount:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "22.20.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node@4.63.2"
    }
  }
}
