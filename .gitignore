# Working documents of the project do not go into the repository.
# A fresh clone comes without docs/ and without CLAUDE.md — backed up outside git.
*.md
!README.md

# UI generator export: carries its own package.json and a .env with a key.
# Ported into apps/web by hand (M0); the folder itself never enters the repo.
design-export/

# Node
node_modules/
dist/
build/
*.tsbuildinfo
.vite/

# Rust / Anchor
target/
.anchor/
test-ledger/
.build.log

# Secrets. The program keypair too: it grants deploying under the same address.
# The audit key and the mint authority are keypair files as well, kept outside the repo.
.env
.env.*
!.env.example
*.pem
id.json
*-keypair.json
*.keypair.json

# Developer environment
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
