# Спільне
SOLANA_RPC_URL=
SOLANA_CLUSTER=devnet
CCS_MINT=
CCS_PROGRAM_ID=8tX3MJt6vzw9fw7gAeBdEtom5cfXR8BMZn9UCPQJrj6z

# apps/api
API_PORT=8787
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173
# Платник доказових транзакцій: base58 64-байтового keypair, лише SOL на комісії й ренту.
PROOF_PAYER_SECRET=
# Лише devnet: окремий faucet-гаманець з обмеженим публічним балансом демо-токена
# (оператор поповнює `tools/mint mint-to`); authority мінта на сервері немає.
FAUCET_ENABLED=false
FAUCET_SECRET=

# apps/api, apps/worker — Supabase
# transaction pooler :6543 для рантайму
DATABASE_URL=
# session pooler :5432 лише для міграцій
MIGRATE_DATABASE_URL=

# apps/web (Vite читає лише VITE_*)
VITE_SOLANA_RPC_URL=
VITE_API_URL=http://localhost:8787
VITE_CCS_MINT=
