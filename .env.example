# Shared
SOLANA_RPC_URL=
SOLANA_CLUSTER=devnet
CCS_MINT=
CCS_PROGRAM_ID=8tX3MJt6vzw9fw7gAeBdEtom5cfXR8BMZn9UCPQJrj6z

# tools/mint (operator, not server): folder with mint-authority.json and auditor-elgamal.json,
# ~/.config/ccsupport by default; the keys never reach the repo or the server.
CCS_KEYS_DIR=

# apps/api
API_PORT=8787
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:5173
# Payer of the proof transactions: base58 of a 64-byte keypair, SOL for fees and rent only.
PROOF_PAYER_SECRET=
# Devnet only: a separate faucet wallet with a limited SOL balance (the operator tops it up
# with `solana airdrop`) and demo token (`tools/mint mint-to`); hands out 0.02 SOL + 100 SUPD per
# request, 3/hour per wallet; needs CCS_MINT. The mint authority is not on the server.
FAUCET_ENABLED=false
FAUCET_SECRET=

# apps/api, apps/worker — Supabase
# transaction pooler :6543 for runtime
DATABASE_URL=
# session pooler :5432 for migrations only
MIGRATE_DATABASE_URL=

# apps/web (Vite reads VITE_* only)
VITE_SOLANA_RPC_URL=
VITE_API_URL=http://localhost:8787
VITE_CCS_MINT=
VITE_CCS_PROGRAM_ID=8tX3MJt6vzw9fw7gAeBdEtom5cfXR8BMZn9UCPQJrj6z
