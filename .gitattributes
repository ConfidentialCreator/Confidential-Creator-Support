# Line endings are normalised to LF on commit.
# This must exist BEFORE the first commit: otherwise CRLF creeps into scripts and the
# WSL build fails with a message that never points at the real cause.
* text=auto eol=lf

# These types break under CRLF unconditionally — pinned explicitly.
*.sh   text eol=lf
*.rs   text eol=lf
*.toml text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.sql  text eol=lf

# Binary — leave alone
*.png  binary
*.jpg  binary
*.ico  binary
*.so   binary
*.wasm binary

# Locks do not bloat review diffs
pnpm-lock.yaml -diff
Cargo.lock     -diff
